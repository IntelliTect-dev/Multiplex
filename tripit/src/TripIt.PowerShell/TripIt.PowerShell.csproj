<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TripIt.PowerShell</RootNamespace>
    <AssemblyName>TripIt.PowerShell</AssemblyName>
    <Description>PowerShell binary module for the TripIt web SPA backend.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Suppress PSStandard's nullable warnings from older type forwarding. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TripIt\TripIt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TripIt.psd1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
