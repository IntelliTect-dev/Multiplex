using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using {{Namespace}};
using {{Namespace}}.Auth;

// MCP entry point for the {{ProjectName}} wrapper.
// Auth model: {{AuthModel}}.
//
// MCP servers using stdio MUST log to stderr only - the stdout channel is
// reserved for the JSON-RPC protocol frames.

var builder = Host.CreateApplicationBuilder(args);

builder.Logging.ClearProviders();
builder.Logging.AddConsole(o => o.LogToStandardErrorThreshold = LogLevel.Trace);

// Where a signed-in session is saved: DPAPI on Windows, user-secrets elsewhere.
builder.Services.AddSingleton<ISessionStore>(_ =>
    OperatingSystem.IsWindows()
        ? new DpapiSessionStore()
        : new UserSecretsSessionStore());

// Polite by default: one request at a time, spaced out, a site's Retry-After
// honoured, retries only for GET/HEAD, and a block never retried. Tuned through
// the {{ProjectName}}_PACING_* environment variables (PacingOptions.FromEnvironment),
// read once at startup -- here, before the host is built, rather than in a
// factory the first tool call would run -- so a bad value fails the server
// here, not mid-call.
var pacing = PacingOptions.FromEnvironment();
builder.Services.AddSingleton(pacing);

// The session is the opposite case: it is NOT read here. {{ProjectName}}ToolSession
// reads the store at the first tool call and builds the client then, so the
// server starts and lists its tools with no session saved, and never prompts
// for one: a prompt on a stdio server would be written into the protocol
// stream. A tool called without a session answers with an error that says so.
builder.Services.AddSingleton(sp =>
{
    var options = sp.GetRequiredService<PacingOptions>();
    var clientLog = sp.GetService<ILogger<{{ProjectName}}Client>>();
    return new {{ProjectName}}ToolSession(
        sp.GetRequiredService<ISessionStore>(),
        credentials => new {{ProjectName}}Client(credentials, options, innerHandler: null, clientLog),
        sp.GetService<ILogger<{{ProjectName}}ToolSession>>());
});

builder.Services
    .AddMcpServer()
    .WithStdioServerTransport()
    .WithToolsFromAssembly();

await builder.Build().RunAsync();
