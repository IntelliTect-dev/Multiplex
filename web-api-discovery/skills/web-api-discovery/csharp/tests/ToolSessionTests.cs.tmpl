        using var session = new {{ProjectName}}ToolSession(store, credentials => { built.Add(credentials); return ClientAnswering(credentials); });

        var first = await session.RunAsync(client => Task.FromResult(client));
        var second = await session.RunAsync(client => Task.FromResult(client));

        Assert.Same(first, second);
        Assert.Equal(1, store.Loads);
        Assert.Equal(new[] { SignedIn }, built);
