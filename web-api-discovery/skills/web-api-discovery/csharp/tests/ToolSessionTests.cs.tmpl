        var impatient = new PacingOptions
        {
            MinimumSpacing = TimeSpan.Zero,
            SpacingJitter = TimeSpan.Zero,
            AttemptTimeout = TimeSpan.FromMilliseconds(50),
        };
        var store = new CountingSessionStore { Saved = SignedIn };
        using var session = new {{ProjectName}}ToolSession(
            store,
            credentials => new {{ProjectName}}Client(credentials, impatient, new SilentSite()));

        var error = await Assert.ThrowsAsync<McpException>(
            () => session.RunAsync(client => client.SendRawAsync("/items", HttpMethod.Post, jsonBody: "{}")));

        Assert.Contains("did not respond within", error.Message);
        Assert.Contains("may still have taken effect", error.Message);
        Assert.IsType<TimeoutException>(error.InnerException);
    }

