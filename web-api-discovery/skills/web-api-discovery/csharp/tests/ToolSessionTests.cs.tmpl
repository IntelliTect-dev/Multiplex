        // signed in.
        var store = new CountingSessionStore();
        var built = 0;

        using var session = new {{ProjectName}}ToolSession(store, credentials => { built++; return ClientAnswering(credentials); });

        Assert.Equal(0, store.Loads);
        Assert.Equal(0, built);
