        // Were a refused call to throw the client away, a model retrying
        // against a dead session would get a new handler for every call, and
        // send as fast as it could ask.
        var store = new CountingSessionStore { Saved = SignedIn };
        var built = 0;
        using var session = new {{ProjectName}}ToolSession(
            store,
            credentials => { built++; return ClientAnswering(credentials, HttpStatusCode.Unauthorized); });

