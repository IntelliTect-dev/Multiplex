/// <summary>A session store held in memory that counts how often it is read.</summary>
internal sealed class CountingSessionStore : ISessionStore
{
    /// <summary>Stands in for a real store's path, which must not reach the model.</summary>
    public const string Location = "counting-store:/a/path/that/must/not/reach/the/model";

    public SessionCredentials? Saved { get; set; }

    public int Loads { get; private set; }

    public string Description => Location;

    public bool TryLoad(out SessionCredentials credentials)
    {
        Loads++;
        credentials = Saved ?? new SessionCredentials(string.Empty, string.Empty);
        return Saved is not null;
    }

    public void Save(SessionCredentials credentials) => Saved = credentials;

    public void Clear() => Saved = null;
}

