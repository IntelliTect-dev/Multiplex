    /// <summary>A site that never answers: a request to it waits until it is cancelled.</summary>
    private sealed class SilentSite : HttpMessageHandler
    {
        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
        {
            await Task.Delay(Timeout.InfiniteTimeSpan, cancellationToken);
            throw new InvalidOperationException("A cancelled wait does not get here.");
        }
    }

