        var error = await Assert.ThrowsAsync<McpException>(() => session.RunAsync(client => client.SendRawAsync("/anything")));
        await Assert.ThrowsAsync<McpException>(() => session.RunAsync(client => client.SendRawAsync("/anything")));

        Assert.Contains("401", error.Message);
        Assert.Contains("does not need restarting", error.Message);
        Assert.IsType<{{ProjectName}}AuthenticationException>(error.InnerException);
        Assert.Equal(2, store.Loads);
