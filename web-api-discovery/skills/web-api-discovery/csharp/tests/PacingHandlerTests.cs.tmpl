    private sealed class ManualClock : TimeProvider
    {
        public DateTimeOffset Now { get; private set; } = new(2026, 1, 1, 0, 0, 0, TimeSpan.Zero);
        public override DateTimeOffset GetUtcNow() => Now;
        public void Advance(TimeSpan by) { lock (this) Now += by; }
    }

    /// <summary>Answers each request with the next scripted reply, and counts what reached it.</summary>
    private sealed class ScriptedHandler : HttpMessageHandler
    {
        private readonly Queue<Func<HttpRequestMessage, HttpResponseMessage>> _replies;
        private readonly Func<HttpRequestMessage, HttpResponseMessage> _last;
        private int _inFlight;

        public ScriptedHandler(params Func<HttpRequestMessage, HttpResponseMessage>[] replies)
        {
            _replies = new Queue<Func<HttpRequestMessage, HttpResponseMessage>>(replies);
            _last = replies.Length > 0 ? replies[^1] : (_ => Ok());
        }

        public int Calls;
        public int MaxInFlight;

        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
        {
            Interlocked.Increment(ref Calls);
            var now = Interlocked.Increment(ref _inFlight);
            lock (this) MaxInFlight = Math.Max(MaxInFlight, now);
            try
            {
                // Give any other request the chance to overlap this one.
                await Task.Delay(5, cancellationToken);
                Func<HttpRequestMessage, HttpResponseMessage> reply;
                lock (_replies) reply = _replies.Count > 0 ? _replies.Dequeue() : _last;
                return reply(request);
            }
            finally
            {
                Interlocked.Decrement(ref _inFlight);
            }
        }
    }

    private sealed record Rig(HttpClient Http, ScriptedHandler Site, ManualClock Clock, List<TimeSpan> Waits);

    private static Rig Build(PacingOptions options, double random, params Func<HttpRequestMessage, HttpResponseMessage>[] replies)
    {
        var clock = new ManualClock();
        var waits = new List<TimeSpan>();
        var site = new ScriptedHandler(replies);
        var handler = new PacingHandler(options, null, clock, (wait, _) =>
        {
            lock (waits) waits.Add(wait);
            clock.Advance(wait);
            return Task.CompletedTask;
        }, () => random)
        {
            InnerHandler = site,
        };
        return new Rig(new HttpClient(handler), site, clock, waits);
    }

    private static readonly PacingOptions Unspaced = new() { MinimumSpacing = TimeSpan.Zero, SpacingJitter = TimeSpan.Zero };

    private static StringContent Json() => new("{}", System.Text.Encoding.UTF8, "application/json");

    private static HttpResponseMessage Ok() => new(HttpStatusCode.OK) { Content = Json() };

    private static Func<HttpRequestMessage, HttpResponseMessage> Status(HttpStatusCode status, string? retryAfter = null) => _ =>
    {
        var response = new HttpResponseMessage(status) { Content = Json() };
        if (retryAfter is not null) response.Headers.TryAddWithoutValidation("Retry-After", retryAfter);
        return response;
    };

    private static Func<HttpRequestMessage, HttpResponseMessage> Succeed => _ => Ok();

    private const string Url = "https://example.test/api/items";

    [Fact]
    public async Task Requests_are_spaced_by_the_minimum_plus_bounded_jitter()
    {
        var options = new PacingOptions { MinimumSpacing = TimeSpan.FromSeconds(1), SpacingJitter = TimeSpan.FromMilliseconds(200) };
        foreach (var random in new[] { 0.0, 0.5, 1.0 })
        {
            var rig = Build(options, random, Succeed);
            (await rig.Http.GetAsync(Url)).EnsureSuccessStatusCode();
            (await rig.Http.GetAsync(Url)).EnsureSuccessStatusCode();

            var wait = Assert.Single(rig.Waits);
            Assert.InRange(wait, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1.2));
            Assert.Equal(TimeSpan.FromSeconds(1) + TimeSpan.FromMilliseconds(200 * random), wait);
        }
    }

    [Fact]
    public async Task Only_one_request_is_in_flight_by_default()
    {
        var rig = Build(Unspaced, 0.5, Succeed);
        var responses = await Task.WhenAll(Enumerable.Range(0, 5).Select(_ => rig.Http.GetAsync(Url)));
        Assert.All(responses, r => Assert.Equal(HttpStatusCode.OK, r.StatusCode));
        Assert.Equal(5, rig.Site.Calls);
        Assert.Equal(1, rig.Site.MaxInFlight);
    }

