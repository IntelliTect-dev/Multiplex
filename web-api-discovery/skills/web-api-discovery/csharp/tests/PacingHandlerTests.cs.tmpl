    [Fact]
    public async Task Without_Retry_After_it_backs_off_exponentially_with_jitter()
    {
        var options = new PacingOptions
        {
            MinimumSpacing = TimeSpan.Zero, SpacingJitter = TimeSpan.Zero, MaxAttempts = 3,
            BackoffBase = TimeSpan.FromSeconds(1), BackoffMax = TimeSpan.FromSeconds(30),
        };
        var rig = Build(options, 0.5, Status(HttpStatusCode.TooManyRequests), Status(HttpStatusCode.TooManyRequests), Succeed);
        var response = await rig.Http.GetAsync(Url);
        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
        Assert.Equal(3, rig.Site.Calls);
        Assert.Equal(2, rig.Waits.Count);
        // Step 1 s then 2 s; equal jitter puts each in [step/2, step].
        Assert.InRange(rig.Waits[0], TimeSpan.FromSeconds(0.5), TimeSpan.FromSeconds(1));
        Assert.InRange(rig.Waits[1], TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
        Assert.True(rig.Waits[1] > rig.Waits[0], "the backoff grows");
    }

