    /// <summary>Answers 200, and keeps a copy of the headers of every request that reaches the site.</summary>
    private static Func<HttpRequestMessage, HttpResponseMessage> Recording(List<Dictionary<string, string>> seen) => request =>
    {
        var headers = request.Headers.ToDictionary(h => h.Key, h => string.Join(" ", h.Value), StringComparer.OrdinalIgnoreCase);
        lock (seen) seen.Add(headers);
        return Ok();
    };

    [Fact]
    public async Task The_client_names_itself_and_sends_no_browser_fingerprint()
    {
        // The client says what it is and sends what the API needs -- the session
        // and its CSRF token. Nothing it sends is there to pass for a browser.
        var seen = new List<Dictionary<string, string>>();
        var creds = new SessionCredentials("test=1", "csrf-1");
        using var client = new {{ProjectName}}Client(creds, Unspaced, new ScriptedHandler(Recording(seen)));
        await client.SendRawAsync("/api/items");

        var headers = Assert.Single(seen);
        Assert.StartsWith("{{ProjectName}}/", headers["User-Agent"]);
        Assert.DoesNotContain("Mozilla", headers["User-Agent"]);
        Assert.Equal("test=1", headers["Cookie"]);
        Assert.Equal("csrf-1", headers["X-CSRF-Token"]);
        Assert.DoesNotContain(headers.Keys, name => name.StartsWith("Sec-", StringComparison.OrdinalIgnoreCase));
        Assert.DoesNotContain("Upgrade-Insecure-Requests", headers.Keys);
        Assert.DoesNotContain("Accept-Language", headers.Keys);
    }

    [Fact]
    public async Task The_User_Agent_is_whatever_the_options_say()
    {
        // Name your own deployment and how the site can reach you -- in code, or
        // through the environment for the MCP server.
        const string mine = "AcmeTripSync/2.1 (+https://acme.example/about-this-client)";
        var seen = new List<Dictionary<string, string>>();
        var options = new PacingOptions { MinimumSpacing = TimeSpan.Zero, SpacingJitter = TimeSpan.Zero, UserAgent = mine };
        using var client = new {{ProjectName}}Client(new SessionCredentials("test=1", string.Empty), options, new ScriptedHandler(Recording(seen)));
        await client.SendRawAsync("/api/items");
        Assert.Equal(mine, Assert.Single(seen)["User-Agent"]);

        var prefix = PacingOptions.EnvironmentPrefix;
        Assert.Equal(mine, PacingOptions.FromEnvironment(name => name == prefix + "USER_AGENT" ? mine : null).UserAgent);
        Assert.Equal(PacingOptions.Default.UserAgent, PacingOptions.FromEnvironment(_ => null).UserAgent);
    }

