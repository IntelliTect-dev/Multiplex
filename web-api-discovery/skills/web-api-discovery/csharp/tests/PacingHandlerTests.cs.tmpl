    [Fact]
    public void Options_come_from_the_environment_and_refuse_nonsense()
    {
        var prefix = PacingOptions.EnvironmentPrefix;
        var env = new Dictionary<string, string>
        {
            [prefix + "MIN_SPACING_MS"] = "2500",
            [prefix + "JITTER_MS"] = "0",
            [prefix + "MAX_ATTEMPTS"] = "5",
            [prefix + "MAX_RETRY_AFTER_SECONDS"] = "30",
            [prefix + "RETRY_METHODS"] = "get, head, put",
        };
        var options = PacingOptions.FromEnvironment(name => env.TryGetValue(name, out var v) ? v : null);
        Assert.Equal(TimeSpan.FromMilliseconds(2500), options.MinimumSpacing);
        Assert.Equal(TimeSpan.Zero, options.SpacingJitter);
        Assert.Equal(5, options.MaxAttempts);
        Assert.Equal(TimeSpan.FromSeconds(30), options.MaxRetryAfter);
        Assert.Contains(HttpMethod.Put, options.RetryMethods);
        Assert.Equal(1, options.MaxConcurrentRequests);

        var defaults = PacingOptions.FromEnvironment(_ => null);
        Assert.Equal(PacingOptions.Default.MinimumSpacing, defaults.MinimumSpacing);
        Assert.Equal(TimeSpan.FromSeconds(60), defaults.MaxRetryAfter);

        Assert.Throws<FormatException>(() => PacingOptions.FromEnvironment(
            name => name == prefix + "MAX_ATTEMPTS" ? "lots" : null));
        Assert.Throws<ArgumentOutOfRangeException>(() => PacingOptions.FromEnvironment(
            name => name == prefix + "MAX_ATTEMPTS" ? "0" : null));
    }

