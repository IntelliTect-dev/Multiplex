name: ci

on:
  push:
    branches: ["**"]
  pull_request:
    branches: ["**"]

permissions:
  contents: read

jobs:
  build-test:
    name: build + test
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Setup .NET
        # Keep this version pinned to the same major.minor as the generated
        # wrapper csproj's <TargetFramework> (currently net10.0). Update both
        # together when bumping to a new LTS.
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 10.0.x
      - name: Restore
        run: dotnet restore
      - name: Build
        run: dotnet build --configuration Release --no-restore
      - name: Test
        run: dotnet test --configuration Release --no-build --verbosity normal
      - name: MCP smoke test
        # Starts the wrapper's MCP server over stdio and checks the tools it
        # lists (tests/<Name>.Tests/pester/Mcp.Tests.ps1). `dotnet test` above
        # does not run it: it is a Pester suite. With CI set, as it is here,
        # the suite fails rather than skips when it cannot start the server.
        shell: pwsh
        run: |
          $runners = @(Get-ChildItem tests -Recurse -Filter run-pester.ps1)
          if ($runners.Count -eq 0) { throw 'No tests/**/pester/run-pester.ps1 found: the MCP smoke test is missing.' }
          foreach ($runner in $runners) {
            & $runner.FullName
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          }