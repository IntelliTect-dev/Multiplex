<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Multiplex.Sites.GoogleFlights.PowerShell</RootNamespace>
    <AssemblyName>Multiplex.Sites.GoogleFlights.PowerShell</AssemblyName>
    <Description>PowerShell commands for Google Flights, over the Multiplex Google Flights client.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoogleFlights\GoogleFlights.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GoogleFlights.psd1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GoogleFlights.Format.ps1xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Generated from GoogleFlightsDocs by the help test: edit the descriptions there, not here. -->
    <None Include="en-US\Multiplex.Sites.GoogleFlights.PowerShell.dll-Help.xml" CopyToOutputDirectory="PreserveNewest" Condition="Exists('en-US\Multiplex.Sites.GoogleFlights.PowerShell.dll-Help.xml')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GoogleFlights.Tests" />
  </ItemGroup>

</Project>
