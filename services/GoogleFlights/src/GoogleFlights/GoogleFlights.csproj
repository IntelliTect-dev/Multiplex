<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Multiplex.Sites.GoogleFlights</RootNamespace>
    <AssemblyName>Multiplex.Sites.GoogleFlights</AssemblyName>
    <Description>Google Flights client over Google Flights' own web endpoints (direct HTTP, no browser).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Document what needs explaining; a self-describing member or parameter needs no tag. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\airlines.json" LogicalName="Multiplex.Sites.GoogleFlights.airlines.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GoogleFlights.Tests" />
  </ItemGroup>

</Project>
