<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each service keeps its saved pages in Services/<Name>/Fixtures; they keep that path in the output folder. -->
    <Content Include="Services\*\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Google Flights' fixtures are its committed, scrubbed references, not copies. -->
    <None Include="..\..\services\GoogleFlights\references\google-flights\*.har" Link="Services\GoogleFlights\References\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\services\GoogleFlights\references\pages\*.html" Link="Services\GoogleFlights\References\Pages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Multiplex.Web\Multiplex.Web.csproj" />
  </ItemGroup>

</Project>